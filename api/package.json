{
  "name": "simoouahbi-eco-api",
  "private": true,
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "npm run prisma:generate && tsx watch src/server.ts",
    "build": "npm run prisma:generate && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate --schema prisma/postgresql/schema.prisma && prisma generate --schema prisma/mongodb/schema.prisma",
    "db:push:postgres": "prisma db push --schema prisma/postgresql/schema.prisma",
    "db:push:mongodb": "prisma db push --schema prisma/mongodb/schema.prisma",
    "db:migrate:postgres": "prisma migrate deploy --schema prisma/postgresql/schema.prisma",
    "test": "tsx --test src/protectedUSERS_root_path_secure/githubAuth.test.ts"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "prisma": "5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3"
  }
}
